---
import BaseLayout from '../layouts/BaseLayout.astro';
import coords from '../../data/coordinates.json';
const transformations = [...new Set(coords.map(x=>x.transformation_pattern))];
const topologies = [...new Set(coords.map(x=>x.completion_topology))];
const persistence = [...new Set(coords.map(x=>x.persistence_mode))];
---
<BaseLayout title="Grammar — The Moving Invariant"><section class="hero"><div class="eyebrow">Canonical reference</div><h1>The grammar</h1><p class="lede">Six Transformation Patterns × three Completion Topologies × three Persistence Modes = 54 coordinate positions, joined by Dimensional Conjunction.</p></section>
<section><h2>The unit</h2><p class="research-copy">A completed intelligible unit is a local answering of structured unresolvedness that becomes determinate enough for uptake and inheritance. Completion is the level of the phenomenon; Settlement is one Transformation Pattern within that level.</p></section>
<section><h2>Transformation Pattern</h2><div class="grid">{transformations.map(x=><article class="card"><h3>{x}</h3><p>{({Differentiation:'A difference that was unavailable, flattened, conflated, or non-operative becomes determinate enough to matter.',Opening:'Availability, reach, continuation, access, or possibility becomes greater than it was under the opening constraint.',Relating:'A bearing, dependency, correspondence, ordering, reciprocity, or mutual determination becomes constitutive.',Repair:'An organization that fails relative to an operative criterion changes so the misfit or fault no longer governs.',Integration:'Separate parts acquire determinate roles through organization into a whole.',Settlement:'A live demand for further uptake, choice, explanation, completion, adjudication or continuation is discharged.'} as any)[x]}</p></article>)}</div></section>
<section><h2>Completion Topology</h2><div class="grid">{topologies.map(x=><article class="card"><h3>{x}</h3><p>{x==='Focal'?'Completion gathers around one privileged locus.':x==='Distributed'?'Completion requires a constitutive plurality, span, sequence, range, field, set of cases or system.':'Completion occurs because prior governance loses its determining force. Release is de-governance, not mere negation or removal.'}</p></article>)}</div></section>
<section><h2>Persistence Mode</h2><div class="grid">{persistence.map(x=><article class="card"><h3>{x}</h3><p>{x==='Standing'?'The achieved determination itself remains available.':x==='Bearing'?'The result remains what it is through a constitutive relation, dependency, contrast, condition, source, frame or support.':'The result remains as accomplished capacity, operative effect, changed continuation, rule, function or consequential difference.'}</p></article>)}</div></section>
<section><h2>Dimensional Conjunction</h2><p class="quote">The coordinate generates one unified characteristic of completed intelligibility, not three features bundled together.</p><p class="research-copy">Do not use lexical templates: Focal is not “one noun”; Distributed is not plural wording; Release is not “no longer”; Standing is not “is”; Bearing is not “depends”; Efficacy is not “can”; Settlement is not “sentence finished.”</p></section>
<section><h2>The 54 addresses</h2><div class="coordinate-grid">{coords.map(c=><div class="coord"><span class="kicker">{c.id}</span><strong>{c.transformation_pattern}</strong><div>{c.completion_topology} · {c.persistence_mode}</div>{c.canonical_crystallization && <div class="meta">{c.canonical_crystallization}</div>}</div>)}</div></section></BaseLayout>
