---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../content/page-data';
export function getStaticPaths(){return Object.entries(pages).map(([slug,page])=>({params:{slug},props:{page}}));}
const { page } = Astro.props;
---
<BaseLayout title={`${page.title} — The Moving Invariant`}><section class="hero"><div class="eyebrow">{page.eyebrow}</div><h1>{page.title}</h1><p class="lede">{page.lede}</p></section><article class="research-copy">{page.sections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p>{page.title==='Machine Invariance' && heading==='Information partition' && <div class="flow"><span>Unit</span><b>→</b><span>Blind Assay</span><b>→</b><span>Frozen Evidence</span><b>→</b><span>Structural Decoder</span><b>→</b><span>Coordinate</span></div>}</section>)}</article></BaseLayout>
